PORT=3001
# Cadena de MongoDB Atlas. Sustituye usuario, contraseña y host.
# Si la contraseña tiene caracteres como @ : / ? #, codifícalos (por ejemplo @ pasa a %40).
# En Atlas: Database → Connect → Drivers → Node.js. La base la elige MONGODB_DB_NAME.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=poc_anonymize
